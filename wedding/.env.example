# Netlify environment variables (Project configuration → Environment variables).
# SETUP_CODE: a one-time code (12+ characters) used once on /setup to choose the couple password.
SETUP_CODE=
# Optional. Normally leave these empty: the password is chosen on /setup and a session
# signing secret is created automatically and stored privately in Netlify Blobs.
COUPLE_PASSWORD_HASH=
SESSION_SECRET=
