# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is already git-ignored.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/clickco?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sessions / crypto (server-only secrets, never exposed to client) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Shared secret required in the Authorization header of /api/cron/* endpoints
CRON_SECRET=""

# --- Super Admin seed ---
# Read ONLY by `npm run db:seed` to create/update the Super Admin account (password is hashed
# with bcrypt before it ever touches the database). Not read by the running application.
# Rotate or remove this value after the first deploy.
SUPER_ADMIN_EMAIL="clickandcocompany@gmail.com"
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Click & Co Admin"

# --- Email (SMTP) ---
# Works with any SMTP provider (Postmark, Resend SMTP, SES, Gmail, etc). Leave blank in dev:
# outgoing email is logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Click & Co <hello@clickandco.app>"

# --- Stripe ---
# Leave blank to run with the Payments UI in "not configured" state.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- File storage ---
# "local" stores uploads on disk under /public/uploads (default, works out of the box).
# Set to "s3" and fill in the S3_* vars to use S3-compatible object storage in production.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
