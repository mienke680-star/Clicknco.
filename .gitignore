# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (match anywhere — a misplaced `cd` before `next build` has written this
# under src/app/ before; don't rely on it only ever landing at the repo root)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify
.netlify
deploy-*.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media (local storage driver)
/public/uploads

# generated Prisma client
/src/generated/prisma

